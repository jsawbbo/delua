# .clang-format for Lua C source code style
# Based on the formatting used in the official Lua repository

# Base style - using LLVM as a starting point since it's close
BasedOnStyle: LLVM

# Indentation
IndentWidth: 2
UseTab: Never
TabWidth: 2
ContinuationIndentWidth: 2

# Namespace indentation - indent contents like a class
NamespaceIndentation: All

# Braces - K&R style with braces on the same line for functions
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true      # Opening brace on same line as function
  AfterControlStatement: false  # Opening brace on same line for if/for/while
  AfterEnum: true
  AfterStruct: true
  AfterClass: true
  BeforeElse: false
  BeforeCatch: false

# Function formatting
AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: true
AllowShortLoopsOnASingleLine: true

# Spaces
SpaceBeforeParens: ControlStatements  # space before ( in if/for/while
SpaceAfterCStyleCast: false           # no space after cast: (int)x
PointerAlignment: Right               # int *x (asterisk attached to variable)
ReferenceAlignment: Right             # int &x (ampersand attached to variable)

# Parentheses and brackets
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpacesInAngles: false

# Other
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignTrailingComments: true

# Column limit - Lua source typically uses 80-100 columns
ColumnLimit: 80

# Control statements
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
